@model PocketPlanetarium.Models.PersonalizedPlanet

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>PersonalizedPlanet</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.planet)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.planet.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.planetarium)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.planetarium.userId)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.personalizedPlanetId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
