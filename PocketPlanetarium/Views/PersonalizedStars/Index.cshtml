@model IEnumerable<PocketPlanetarium.Models.PersonalizedStar>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.star)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.planetarium)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.star.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.planetarium.userId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.personalizedStarId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.personalizedStarId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.personalizedStarId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
