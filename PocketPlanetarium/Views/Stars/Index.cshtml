@model IEnumerable<PocketPlanetarium.Models.Star>

@{
    ViewData["Title"] = "Stars";
}

<div class="title">
    <h1>Stars</h1>

    <p>
        <a asp-action="Create">Create New</a>
    </p>
</div>
<table class="table">
    <!--
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.distance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.mass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StellarMagnitude)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiscoveryDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagePath)
            </th>
            <th></th>
        </tr>
    </thead>
    -->
    <tbody>
@foreach (var item in Model) {
        <tr class="output">
            <td class="itemName">
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td class="itemDistance">
                    <p style="font-size:smaller;margin-bottom:0;">Distance from Earth in Parsecs:</p>
                    @Html.DisplayFor(modelItem => item.distance)
            </td>               
            <td class="itemMass">
                    <p style="font-size:smaller;margin-bottom:0;">Mass of planet in Earths:</p>
                    @Html.DisplayFor(modelItem => item.mass)
            </td>               
            <td class="itemMagnitude">
                    <p style="font-size:smaller;margin-bottom:0;">Stellar Magnitude:</p>
                    @Html.DisplayFor(modelItem => item.StellarMagnitude)
            </td>  
            <td class="itemDate">
                    <p style="font-size:smaller;margin-bottom:0;">Year Discovered:</p>
                    @Html.DisplayFor(modelItem => item.DiscoveryDate)
            </td>
            <td>
                <img class="tableImage" src="@Html.DisplayFor(modelItem=> item.ImagePath)" alt="@Html.DisplayFor(modelItem => item.Name)" />
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.starId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.starId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.starId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
